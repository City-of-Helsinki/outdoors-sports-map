# Copy this to .env

# Servicemap API
REACT_APP_API_URL=https://api.hel.fi/servicemap/v2

# Digitransit Geocoding API
# Server-only: used by Nginx in production and the Vite proxy in development
# Supply through container secrets in production; uncomment in .env for local development.
# Never include these in the base image's browser environment configuration.
# DIGITRANSIT_API_URL=https://api.digitransit.fi/geocoding/v1
# DIGITRANSIT_API_KEY=

REACT_APP_APP_NAME=outdoors-sports-map
REACT_APP_MAP_URL_TEMPLATE="https://maptiles.api.hel.fi/styles/hel-osm-light-{language}/{z}/{x}/{y}{suffix}.png"
# Set to 'true' to disable season-based unit filtering and show all sport types year-round
REACT_APP_BYPASS_SEASON_FILTER=false

# Sentry error tracking (leave REACT_APP_SENTRY_DSN empty to disable Sentry entirely)
REACT_APP_SENTRY_DSN=
# One of: review, development, testing, staging, production, local
REACT_APP_SENTRY_ENVIRONMENT=local
REACT_APP_SENTRY_RELEASE=
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0
REACT_APP_SENTRY_PROFILE_SESSION_SAMPLE_RATE=0
REACT_APP_SENTRY_TRACE_PROPAGATION_TARGETS=
REACT_APP_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
REACT_APP_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0